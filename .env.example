# Beispielkonfiguration – kopieren nach .env und Werte eintragen.
# Alles ist optional; ohne Angaben läuft Flatswipe lokal unter http://localhost:3000.

# Port und Datenbank
PORT=3000
DB_PATH=/data/wohnungsswipe.db

# Öffentliche Adresse (Links in E-Mails und Push). Mit https:// werden die Login-Cookies
# nur noch über HTTPS gesendet – hinter einem Reverse Proxy so setzen.
BASE_URL=http://localhost:3000

# Signiert die Login-Cookies. Leer lassen: der Server erzeugt beim ersten Start ein
# zufälliges Secret und speichert es neben der Datenbank. Eigenes: openssl rand -hex 32
SESSION_SECRET=

# E-Mail-Benachrichtigungen (ohne SMTP_HOST werden Mails nur geloggt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flatswipe" <noreply@example.com>

# Web-Push: Kontaktadresse für den Push-Dienst; Schlüssel werden automatisch erzeugt
VAPID_SUBJECT=mailto:admin@example.com
# VAPID_FILE=/data/vapid.json

# Optional: KI-Modus für Nachrichten (OpenAI-kompatible Chat-API)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_API_KEY_HEADER=x-api-key

# Optional: Browser-Kennung, mit der Inserate von Kleinanzeigen & Co. abgerufen werden
# SCRAPER_USER_AGENT=
